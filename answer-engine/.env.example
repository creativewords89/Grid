# Copy to .env on the server and fill in. Never commit .env (SPEC section 13.3).

# --- App ---
APP_ENV=production
APP_DOMAIN=answers.gridrankers.com
APP_URL=https://answers.gridrankers.com
# Long random string: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Database (the api and worker build DATABASE_URL from these) ---
POSTGRES_USER=answers
POSTGRES_PASSWORD=
POSTGRES_DB=answers

# --- Claude, Pinecone, Telegram and email ---
# Easier: leave these empty and enter them in the website, Settings → Connections, where
# they're stored encrypted (with SECRET_KEY). A value saved there wins over this file.
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-opus-5-5
REWRITE_MODEL=claude-opus-5-5
CHECK_MODEL=claude-opus-5-5
OCR_MODEL=claude-opus-5-5
PINECONE_API_KEY=
PINECONE_INDEX=answer-engine
# Printed by `python -m app.cli setup-pinecone`; optional.
PINECONE_HOST=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBED_MODEL=llama-text-embed-v2
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Only for testing against a fake Telegram:
# TELEGRAM_API_URL=https://api.telegram.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# --- Backups (ops/backup.sh, run nightly by the backup service) ---
# Time of day (UTC) and how many days to keep them on the server.
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=14
# Optional off-server copy (open decision 5): an rclone remote and folder, e.g.
# b2:gridrankers-backups, with the remote set up through RCLONE_CONFIG_* lines such as
#   RCLONE_CONFIG_B2_TYPE=b2
#   RCLONE_CONFIG_B2_ACCOUNT=<key id>
#   RCLONE_CONFIG_B2_KEY=<application key>
BACKUP_TARGET=
