# Copy to .env on the server and fill in. Never commit .env (SPEC section 10).
# API keys (DataForSEO, Google, SMTP, Telegram …) are NOT set here: they are entered in the
# Hub's Connections screen (SPEC section 6.1).

# --- App ---
APP_ENV=production
APP_DOMAIN=hub.gridrankers.com
APP_URL=https://hub.gridrankers.com
# Long random string: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Database (the api and scheduler build DATABASE_URL from these) ---
POSTGRES_USER=hub
POSTGRES_PASSWORD=
POSTGRES_DB=hub

# --- Backups (ops/backup.sh): nightly at BACKUP_TIME (UTC; 21:30 is 03:30 in Dhaka) ---
BACKUP_TIME=21:30
BACKUP_KEEP_DAYS=14
# Optional off-server copy with rclone, e.g. b2:gridrankers-hub-backups. Configure the
# remote with RCLONE_CONFIG_<NAME>_* variables here (see ops/deploy.md).
BACKUP_TARGET=

# --- Same server as the Answer Engine (ops/deploy.md, "Next to the Answer Engine") ---
# Uncomment both lines there: the Answer Engine's Caddy then serves hub.gridrankers.com.
#COMPOSE_FILE=docker-compose.yml:docker-compose.shared.yml
#ANSWERS_NETWORK=answer-engine_default
